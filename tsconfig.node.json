{
    "extends": "@jubstaa/config/tsconfig/base",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ES2023"],
        "moduleDetection": "force",
        "noEmit": true,
        "noUncheckedSideEffectImports": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["node"]
    },
    "include": [
        "prettier.config.ts",
        "eslint.config.ts",
        "vite.config.ts",
        "manifest.config.ts",
        "vitest.setup.ts",
        "scripts"
    ]
}
